{
  "name": "@layerhop/widget",
  "version": "0.7.0",
  "description": "Embed the LayerHop cross-chain swap widget and checkout in any site: React components, framework-agnostic mount()/openCheckout() and drop-in <script> tags",
  "license": "MIT",
  "author": "LayerHop (https://layerhop.com)",
  "homepage": "https://docs.layerhop.com/widget-reference",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./embed.js": "./dist/embed.js",
    "./checkout.js": "./dist/checkout.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/embed.js",
    "./dist/checkout.js"
  ],
  "keywords": [
    "layerhop",
    "bridge",
    "swap",
    "cross-chain",
    "widget",
    "embed",
    "iframe",
    "react",
    "solana",
    "evm",
    "defi",
    "web3",
    "swap-widget",
    "checkout",
    "payments",
    "crypto-payments",
    "payment-button"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^25.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/layerhop/layerhop-js.git",
    "directory": "packages/widget"
  },
  "bugs": {
    "url": "https://github.com/layerhop/layerhop-js/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
