{
  "name": "@layerhop/react-native",
  "version": "0.7.0",
  "description": "LayerHop for React Native and Expo: the swap widget and checkout as native components (react-native-webview) with typed callbacks, plus wallet deep-link helpers",
  "license": "MIT",
  "author": "LayerHop (https://layerhop.com)",
  "homepage": "https://docs.layerhop.com/sdks/react-native",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "layerhop",
    "react-native",
    "expo",
    "webview",
    "bridge",
    "swap",
    "cross-chain",
    "checkout",
    "crypto-payments",
    "walletconnect",
    "deep-link",
    "solana",
    "evm",
    "defi",
    "web3"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@layerhop/widget": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-native": ">=0.72",
    "react-native-webview": ">=13"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.7",
    "jsdom": "^25.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-native": "0.88.0",
    "react-native-webview": "16.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/layerhop/layerhop-js.git",
    "directory": "packages/react-native"
  },
  "bugs": {
    "url": "https://github.com/layerhop/layerhop-js/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
