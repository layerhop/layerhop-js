{
  "name": "@layerhop/wagmi",
  "version": "0.7.0",
  "description": "Execute LayerHop quotes with wagmi or viem: ERC-20 approval, swap and extra calls in one EIP-5792 confirmation when the wallet supports it, sequential transactions otherwise",
  "license": "MIT",
  "author": "LayerHop (https://layerhop.com)",
  "homepage": "https://docs.layerhop.com/guides/wallets",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./actions": "./src/actions.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.cjs",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./actions": {
        "import": {
          "types": "./dist/actions.d.ts",
          "default": "./dist/actions.js"
        },
        "require": {
          "types": "./dist/actions.d.cts",
          "default": "./dist/actions.cjs"
        }
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "actions": [
          "./dist/actions.d.ts"
        ]
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "layerhop",
    "wagmi",
    "viem",
    "eip-5792",
    "wallet_sendCalls",
    "batch",
    "bridge",
    "swap",
    "cross-chain",
    "evm",
    "web3"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@layerhop/react": "workspace:^",
    "@layerhop/sdk": "workspace:^"
  },
  "peerDependencies": {
    "@tanstack/react-query": ">=5.62.11",
    "react": ">=18",
    "viem": "^2.57.7",
    "wagmi": "^2.19.5"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/react-query": "5.62.11",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "jsdom": "^25.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "viem": "2.57.7",
    "vitest": "^3.2.7",
    "wagmi": "2.19.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/layerhop/layerhop-js.git",
    "directory": "packages/wagmi"
  },
  "bugs": {
    "url": "https://github.com/layerhop/layerhop-js/issues"
  }
}
